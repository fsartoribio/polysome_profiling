#Step3: Trim adapters and low quality bases using Cutadapt


ADAPT=TCTCCTTGCATAATCACCAACC
RCADAPT=GGTTGGTGATTATGCAAGGAGA
ILL_R1=AGATCGGAAGAGCACACGTCTGAACTCCAGTCA
ILL_R2=AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT

cutadapt -j 4 \
  -g "^${RCADAPT}" -G "^${ADAPT}" \
  -b "${ADAPT}"    -B "${ADAPT}" \
  -b "TCCTTGCATAATCACCAACC"   -B "TCCTTGCATAATCACCAACC" \
  -a "${ILL_R1}"   -A "${ILL_R2}" \
  --overlap 8 --error-rate 0.1 \
  -q 20 -m 25 --pair-filter=any --trim-n \
  -o /mnt/targetdiscovery/lung/polysome_profiling_H661_H1573/trim_after_extract/H661_1.trim.fastq.gz \
